{
  "ConnectionStrings": {
    "Database": "Host=home-task-db;Port=5432;Database=home-task;Username=postgres;Password=postgres;"
  },
  "Authentication": {
    "Audience": "account",
    "MetadataAddress": "http://home-task-idp:8080/realms/hometask/.well-known/openid-configuration",
    "ValidIssuer": "http://home-task-idp:8080/realms/hometask",
    "RequireHttpsMetadata": "false"
  },
  "Keycloak": {
    "BaseUrl": "http://home-task-idp:8080",
    "AdminUrl": "http://home-task-idp:8080/admin/realms/hometask/",
    "TokenUrl": "http://home-task-idp:8080/realms/hometask/protocol/openid-connect/token",
    "AdminClientId": "hometask-admin-client",
    "AuthClientId": "hometask-auth-client"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
